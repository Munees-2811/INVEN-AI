# Copy to `.env` (or set as real environment variables) and fill in.
# The app runs fully offline without these — they unlock the live Claude AI
# features (chatbot, OCR, AI reports, voice answers).

# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown).
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_VISION_MODEL=claude-opus-4-8
